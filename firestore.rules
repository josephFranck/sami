rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════ HELPERS ═══════════
    function connecte() { return request.auth != null; }
    function moi() { return request.auth.uid; }
    function monDoc() {
      return get(/databases/$(database)/documents/utilisateurs/$(moi())).data;
    }
    function estAdmin() {
      return connecte() &&
        monDoc().role in ['admin', 'superadmin'];
    }
    function estSuper() {
      return connecte() && monDoc().role == 'superadmin';
    }
    // STAFF = admin/superadmin, OU un compte doté de LA permission
    // précise (le map `permissions` posé par Gestion utilisateurs).
    // Champs touchés par une mise à jour (protection champ par champ)
    function touche(cles) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(cles);
    }
    function estStaff(p) {
      return connecte() && (
        monDoc().role in ['admin', 'superadmin'] ||
        (('permissions' in monDoc()) && monDoc().permissions.hasAny([p]))
      );
    }

    // ═══════════ UTILISATEURS ═══════════
    match /utilisateurs/{uid} {
      allow read: if connecte() && (moi() == uid || estStaff('utilisateurs'));
      allow create: if connecte() && moi() == uid
                    && request.resource.data.role == 'client';
      // On peut éditer SON profil, mais JAMAIS s'auto-promouvoir
      allow update: if connecte() && (
        // HIÉRARCHIE : seul le SUPERADMIN peut modifier un admin ou
        // promouvoir quelqu'un admin/superadmin — un admin ordinaire
        // gère les agents et en-dessous, jamais ses pairs.
        (estAdmin()
          && !(resource.data.get('role','') in ['admin','superadmin']
               && !estSuper())
          && !(request.resource.data.get('role','') in ['admin','superadmin']
               && !estSuper()))
        ||
        estStaff('utilisateurs') ||
        (moi() == uid
         && request.resource.data.role == resource.data.role
         // ANTI AUTO-CRÉDIT : on ne peut pas AUGMENTER son propre solde
         // (le débit — payer en crédits — reste permis ; les gains
         //  passent par les reversements, écrits par le staff)
         && request.resource.data.get('creditBalance', 0)
              <= resource.data.get('creditBalance', 0)
         && request.resource.data.get('permissions', [])
            == resource.data.get('permissions', []))
      );
    
      // PROFILS DE MESURES : sous-collection PERSONNELLE — le chemin
      // porte l'identité, la règle la vérifie (pas de cascade en
      // Firestore : sans ce match imbriqué, deny par défaut).
      match /mesures/{mesureId} {
        allow read, write: if connecte() && uid == moi();
      }
    }


    // ═══════════ CATALOGUE PUBLIC (lecture libre, écriture contrôlée) ═══════════
    match /pagnes/{id} {
      allow read: if true;
      // GÉRANT PRÉCIS : un boutiquier n'écrit que les pagnes de SES
      // boutiques (gerants contient son uid) ; staff/admin : tout.
      // Coût : 1 à 2 get() par écriture — les écritures de pagnes sont
      // rares, la sécurité des PRIX vaut largement ce prix.
      allow create, update: if connecte() && (
          estStaff('pagnes')
          || (
            get(/databases/$(database)/documents/utilisateurs/$(moi()))
                .data.role in ['boutiquier', 'couturier']
            && request.resource.data.get('boutiqueId', '') != ''
            && get(/databases/$(database)/documents/boutiques/$(request.resource.data.boutiqueId))
                .data.get('gerants', []).hasAny([moi()])
          )
      );
      allow delete: if estStaff('boutiques');

      // RÉSERVATIONS DE STOCK (sous-collection) : posées à l'ajout au
      // panier, levées à la commande/annulation — sans ce match : DENY.
      match /reservations/{resId} {
        allow read, write: if connecte();
      }
    }
    match /boutiques/{id} {
      allow read: if true;
      allow update: if estStaff('boutiques')
                    || (connecte() && moi() in resource.data.gerants);
      allow create, delete: if estStaff('boutiques');
    }
    match /categories/{id} {
      allow read: if true;
      allow write: if estStaff('boutiques');
    }
    match /evenements/{id} {
      allow read: if true;
      allow write: if estStaff('evenements');
    }
    match /config_credits/{id} {
      allow read: if true;
      allow write: if estAdmin();
    }

    // ═══════════ COMMANDES & LIVRAISONS ═══════════
    match /sessions_commande/{id} {
      allow read, create: if connecte();
      // Le client ne peut PAS s'auto-confirmer un paiement : les champs
      // financiers ne bougent que par le staff (vérification MoMo déclaré).
      allow update: if connecte() && (
        estStaff('paiements') || estStaff('utilisateurs') ||
        !touche(['paiementConfirme','paiementVerifie','paiementVerifieLe',
                 'refPaiement','methodePaiement','totalPayeClient',
                 'totalArticles','totalLivraisons','clientId']));
      // Vérification des transferts déclarés (agent 'paiements')
      allow update: if estStaff('paiements');
    }
    match /sous_commandes/{id} {
      allow read: if connecte();
      allow create: if connecte() && request.resource.data.clientId == moi();
      // UPDATE réservé aux PARTIES PRENANTES de cette commande :
      // staff, le client, le livreur assigné, ou un gérant de la
      // boutique — un inconnu décompilé ne marque plus rien « livré ».
      allow update: if connecte() && (
        estStaff('utilisateurs') ||
        (
          (resource.data.clientId == moi() ||
           resource.data.livreurId == moi() ||
           get(/databases/$(database)/documents/boutiques/$(resource.data.boutiqueId))
               .data.gerants.hasAny([moi()]))
          // les MONTANTS et le flag de reversement : staff seulement
          && !touche(['sousTotal','totalClient','fraisLivraison','netBoutique',
                      'boutiqueReversee','clientId','boutiqueId','articles'])
        )
      );

      // SOUS-COLLECTION livraisons : étapes de la course. Lecture pour
      // tout connecté (client suit, livreur agit, boutiquier informe) ;
      // écriture idem (le flux la met à jour à chaque scan).
      match /livraisons/{livId} {
        allow read, write: if connecte();
      }
    }
    match /commandes_couturier/{id} {
      allow read, update: if connecte();
      allow create: if connecte() && request.resource.data.clientId == moi();
    }
    match /livraisons/{id} {
      allow read: if connecte();
      // CREATE : par le client qui commande (ou le staff)
      allow create: if connecte() && (
        estStaff('livraisons') || request.resource.data.clientId == moi());
      // UPDATE : client, livreur assigné, gérant de la boutique d'origine,
      // staff — et les champs FINANCIERS ne bougent que par le staff.
      allow update: if connecte() && (
        estStaff('livraisons') ||
        (
          (resource.data.clientId == moi() ||
           resource.data.livreurId == moi() ||
           get(/databases/$(database)/documents/boutiques/$(resource.data.origineId))
               .data.gerants.hasAny([moi()]) ||
           // assignation par l'agent (tourne sur l'appareil du boutiquier/admin)
           !touche(['statut','preuveLivraison','preuveRecuperation','signatureClient']))
          && !touche(['decompositionFinanciere','fraisLivraison','clientId',
                      'origineId','gainLivreur','netBoutique'])
        )
      );
      allow delete: if estAdmin();
    }
    match /qr_secrets/{id} {
      // ═══ ANTI-DÉCOMPILATION ═══ la clé HMAC d'une livraison n'est
      // lisible que par SES participants — un compte quelconque (même
      // avec l'app décompilée et l'algo en main) ne peut pas forger
      // les QR des livraisons d'autrui.
      allow read: if connecte() && (
        estStaff('livraisons') ||
        get(/databases/$(database)/documents/livraisons/$(id))
            .data.clientId == moi() ||
        get(/databases/$(database)/documents/livraisons/$(id))
            .data.livreurId == moi()
      );
      // CREATE : posé à la création de la livraison (même batch) — un doc
      // existant ne peut pas être « re-créé », donc pas d'écrasement.
      allow create: if connecte();
      // UPDATE (régénération des tokens) : participants ou staff SEULEMENT
      allow update: if connecte() && (
        estStaff('livraisons') ||
        get(/databases/$(database)/documents/livraisons/$(id))
            .data.clientId == moi() ||
        get(/databases/$(database)/documents/livraisons/$(id))
            .data.livreurId == moi()
      );
      allow delete: if estAdmin();
    }
    match /retours/{id} {
      allow read, write: if connecte();
    }

    // ═══════════ PARTENAIRES ═══════════
    match /livreurs/{id} {
      allow read: if connecte();
      // Opérationnel (statut, disponible, position, encours) : l'app.
      // ARGENT / VÉRIFICATION / ABONNEMENT : le staff uniquement — un
      // livreur (ou un tiers) ne peut ni se créditer, ni se « vérifier »,
      // ni s'abonner, ni gonfler son compteur de courses.
      allow update: if connecte() && (
        estStaff('utilisateurs') ||
        !touche(['creditBalance','estVerifie','cniVerifiee','abonnementLivreur',
                 'abonnementFinLe','montantCaution','cautionDeposee',
                 'nombreLivraisons','utilisateurId']));
      allow create, delete: if estStaff('candidatures');
    }
    match /couturiers/{id} {
      allow read: if true; // vitrine publique des ateliers
      allow update: if connecte() && (
        estStaff('utilisateurs') ||
        !touche(['typeAbonnement','abonnementFinLe','estVerifie',
                 'creditBalance','utilisateurId']));
      allow create, delete: if estStaff('candidatures');
    }
    match /profils_couturier/{id} {
      allow read: if connecte();
      allow write: if connecte() && (moi() == id || estAdmin());
    }
    match /candidatures/{id} {
      allow create: if connecte() && request.resource.data.utilisateurId == moi();
      allow read: if connecte()
                  && (resource.data.utilisateurId == moi() || estStaff('candidatures'));
      allow update: if estStaff('candidatures');
    }

    // ═══════════ FINANCES (sensible) ═══════════
    match /transactions/{id} {
      allow read: if estAdmin() || (connecte() && resource.data.get('clientId','') == moi());
      allow create: if connecte();        // écrites par l'app au paiement
      allow update: if estStaff('paiements'); // jamais modifiées côté client
    }
    match /transactions_paiement/{id} {
      // Le client CRÉE sa transaction (en attente) et ÉCOUTE la sienne ;
      // la CONFIRMATION n'arrive QUE par le webhook (compte de service,
      // qui contourne ces règles). Avant : update libre = n'importe qui
      // pouvait s'auto-confirmer un paiement sans payer !
      allow read: if estAdmin()
                  || (connecte() && resource.data.get('clientId','') == moi());
      allow create: if connecte()
                    && request.resource.data.get('clientId','') == moi()
                    && request.resource.data.get('statut','') != 'confirme';
      allow update: if estAdmin(); // + webhook (bypass)
    }

    // MESURES du client (privées) + MODÈLES des couturiers + divers actifs
    match /modeles_couture/{id} {
      allow read: if true; // catalogue public
      // CREATE : resource n'existe pas → ne JAMAIS lire resource.data ici
      allow create: if connecte() && (
          estStaff('pagnes') || request.resource.data.couturierId == moi());
      allow update, delete: if connecte() && (
          estStaff('pagnes') || resource.data.couturierId == moi());
    }
    match /signalements_avis/{id} {
      allow create: if connecte();
      allow read, update: if estStaff('avis');
    }
    match /preuves_photo/{id} {
      allow read, create: if connecte();
      allow update, delete: if estStaff('livraisons');
    }
    match /anomalies_livraison/{id} {
      allow read, create: if connecte();
      allow update: if estStaff('livraisons');
    }
    match /mouvements_credits/{id} {
      allow read: if connecte() && resource.data.get('clientId','') == moi()
                  || estStaff('reversements');
      allow create: if connecte();
      allow update, delete: if estStaff('reversements');
    }

    // JOURNAL APPLICATIF : chacun écrit, seul le staff lit
    match /app_logs/{id} {
      allow create: if connecte();
      allow read: if estStaff('parametres');
    }

    // PARRAINAGES : le filleul crée SON lien (en attente) ; staff valide
    match /parrainages/{id} {
      allow read: if connecte() && (
          resource.data.get('parrainId','') == moi()
          || resource.data.get('filleulId','') == moi()
          || estStaff('reversements'));
      allow create: if connecte()
                    && request.resource.data.get('filleulId','') == moi()
                    && request.resource.data.get('statut','') == 'enAttente';
      allow update: if estStaff('reversements');
    }

    // REMBOURSEMENTS : créés par le client à l'annulation, traités par staff
    match /remboursements_a_faire/{id} {
      allow read: if estStaff('reversements')
                  || (connecte() && resource.data.get('clientId','') == moi());
      allow create: if connecte()
                    && request.resource.data.get('clientId','') == moi()
                    && request.resource.data.get('statut','') == 'a_traiter';
      allow update: if estStaff('reversements');
    }
    match /reversements/{id} {
      allow read: if estStaff('reversements')
                  || (connecte() && resource.data.get('beneficiaireId','') == moi());
      allow write: if estStaff('reversements');
    }
    match /recus/{id} {
      allow read: if connecte()
                  && (resource.data.beneficiaireId == moi() || estAdmin());
      allow create: if connecte();
      allow update, delete: if false; // un reçu émis est IMMUABLE
    }
    match /counters/{id} { allow read, write: if connecte(); }

    // ═══════════ COMMUNICATION ═══════════
    match /conversations/{id} {
      allow read, update: if connecte() && moi() in resource.data.participants;
      allow create: if connecte() && moi() in request.resource.data.participants;
      match /messages/{mid} {
        allow read, create: if connecte() && moi() in
          get(/databases/$(database)/documents/conversations/$(id)).data.participants;
      }
    }
    match /notifications/{id} {
      allow read, update: if connecte() && resource.data.destinataireId == moi();
      allow create: if connecte();
    }
    match /avis/{id} {
      allow read: if true;
      allow create: if connecte() && request.resource.data.get('auteurId','') == moi();
      allow update, delete: if estStaff('litiges');
    }

    // ═══════════ CONFIGURATION (le cœur de ta question) ═══════════
    match /app_config/parametres { allow read: if connecte(); allow write: if estStaff('parametres'); }
    match /app_config/version    { allow read: if connecte(); allow write: if estAdmin(); }
    // stockage : workerUrl + urlPublique SEULEMENT (le token R2 n'y est
    // PLUS : l'auth du worker passe par le jeton Firebase de l'utilisateur)
    match /app_config/stockage   { allow read: if connecte(); allow write: if estAdmin(); }
    // Clés marchandes : lisibles par l'app (initiation du paiement côté client),
    // MODIFIABLES PAR PERSONNE d'autre que l'admin.
    match /app_config/paiement   { allow read: if connecte(); allow write: if estAdmin(); }
    // Clé de signature des reçus : idem. TODO à l'échelle : vérification via
    // Cloud Function pour ne plus exposer la clé en lecture.
    match /app_config/recus      { allow read: if connecte(); allow write: if estAdmin(); }
    match /app_config/taxes     { allow read: if connecte(); allow write: if estAdmin(); }
    match /config_marketing/{id} { allow read: if connecte(); allow write: if estAdmin(); }

    // ═══════════ AGENT / LOGS (admin) ═══════════
    // PROMOTIONS : le boutiquier propose la SIENNE, le staff tranche
    match /promotions/{id} {
      allow read: if connecte();
      allow create: if connecte()
                    && request.resource.data.proposePar == moi()
                    && request.resource.data.statut == 'proposee';
      allow update, delete: if estStaff('pagnes');
    }

    match /alertes_agent/{id} {
      allow read: if estStaff('litiges') || estStaff('livraisons');
      allow create: if connecte();                       // l'agent (appareil boutiquier)
      allow update: if estStaff('litiges') || estStaff('livraisons'); // clôture = humain
      allow delete: if estAdmin();
    }
    match /logs_agent/{id}    { allow read: if estAdmin(); allow write: if connecte(); }
    match /demandes_numerisation/{id} {
      allow create: if connecte();
      allow read, update: if estStaff('boutiques') ||
        (connecte() && resource.data.get('demandeurId','') == moi());
    }

    // ═══════════ TOUT LE RESTE : REFUSÉ ═══════════
    match /{document=**} { allow read, write: if false; }
    // ═══════════ COLLECTIONS SANS RÈGLE (audit 03/11/2026) ═══════════
    // Toutes étaient VIVANTES dans le code et refusées en silence.
    match /paniers/{uid} {                      // panier persistant
      allow read, write: if connecte() && uid == moi();
    }
    match /securite_livreurs/{id} {             // profil sécurité (CNI, caution)
      allow read: if connecte();
      allow create: if connecte() && (id == moi() || estStaff('utilisateurs'));
      // vérification d'identité & caution : STAFF uniquement
      allow update: if connecte() && (
        estStaff('utilisateurs') ||
        !touche(['cniVerifiee','montantCaution','cautionDeposee','estVerifie',
                 'scoreConfiance','utilisateurId']));
      allow delete: if estAdmin();
    }
    match /scores_clients/{id} {                // score de fiabilité client
      allow read: if connecte() && (id == moi() || estStaff('utilisateurs'));
      allow write: if connecte();               // calculé par l'app (informatif)
    }
    match /credit_mouvements/{id} {             // mouvements crédits boutique
      allow read: if connecte();
      allow create: if connecte();
      allow update, delete: if estStaff('reversements');
    }
    match /saisies_caution/{id} {               // saisies sur caution livreur
      allow read, write: if estStaff('litiges') || estAdmin();
    }
    match /profils_boutique/{id} {              // profil d'abonnement boutique
      allow read: if connecte();
      allow write: if estStaff('boutiques');
    }
    match /config_taxes/{id} {                  // TVA, taxes (admin)
      allow read: if connecte();
      allow write: if estAdmin();
    }
    match /alertes_admin/{id} {                 // alertes sécurité livreurs
      allow create: if connecte();
      allow read, update, delete: if estStaff('litiges') || estAdmin();
    }
    match /logs_admin/{id} {                    // journal des actions admin
      allow create, read: if estAdmin();
    }

  }
}
